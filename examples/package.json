{
  "name": "@pure-elements/examples",
  "version": "1.0.0",
  "description": "Pure elements examples",
  "keywords": [
    "web components",
    "pure elements"
  ],
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rollup -c rollup-examples.config.ts --configPlugin typescript",
